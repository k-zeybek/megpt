{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Frontend (Vite)",
            "type": "shell",
            "command": "npm run dev",
            "options": { "cwd": "${workspaceFolder}/frontend" },
            "presentation": { "group": "server-group" }
        },
        {
            "label": "Start Backend (FastAPI)",
            "type": "shell",
            "command": "source ${workspaceFolder}/.venv/bin/activate && uvicorn server:app --reload",
            "options": { "cwd": "${workspaceFolder}/backend" },
            "presentation": { "group": "server-group" }
        },
        {
            "label": "🚀 Start MeGPT (Both Servers)",
            "dependsOn": ["Start Frontend (Vite)", "Start Backend (FastAPI)"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
